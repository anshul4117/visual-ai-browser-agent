{
  "manifest_version": 3,
  "name": "Visual AI Browser Agent",
  "version": "1.0.0",
  "description": "Monitors browser activity and visual context, tracks user interactions, and stores structured events.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Visual AI Browser Agent"
  }
}
