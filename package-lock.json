{
  "name": "visual-ai-browser-agent",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "visual-ai-browser-agent",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20.0.0"
      }
    },
    "apps/extension": {
      "name": "@visual-ai/extension",
      "version": "1.0.0",
      "dependencies": {
        "@visual-ai/shared-types": "*"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "apps/server": {
      "name": "@visual-ai/server",
      "version": "1.0.0",
      "dependencies": {
        "@visual-ai/shared-types": "*"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "node_modules/@visual-ai/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@visual-ai/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@visual-ai/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "node_modules/@visual-ai/shared-utils": {
      "resolved": "packages/shared-utils",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/shared-types": {
      "name": "@visual-ai/shared-types",
      "version": "1.0.0",
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/shared-utils": {
      "name": "@visual-ai/shared-utils",
      "version": "1.0.0",
      "dependencies": {
        "@visual-ai/shared-types": "*"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    }
  }
}
