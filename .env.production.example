# Visual AI Browser Agent — Production Environment Variables

# Backend Server Port
PORT=3000

# Environment Mode
NODE_ENV=production

# Cross-Origin Resource Sharing (CORS) Allowed Origins
CORS_ORIGIN=https://visual-ai-dashboard.vercel.app

# Dashboard Public Base URL
DASHBOARD_URL=https://visual-ai-dashboard.vercel.app

# MongoDB Atlas Database URI (Production Cluster)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/visual-ai-browser-agent?retryWrites=true&w=majority

# Google Gemini Vision API Key (Multimodal Model Access)
GEMINI_API_KEY=AIzaSyYourProductionGeminiApiKeyHere

# Frontend Web Dashboard Environment (Vite)
VITE_API_BASE_URL=https://visual-ai-api.onrender.com/api
